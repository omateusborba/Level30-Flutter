# Copie para .env e preencha. NUNCA versione o .env.
#   cp .env.example .env

# ─── Banco (Postgres roda como container, conexão interna) ───────────────
DB_NAME=level30
DB_USER=level30
DB_PASSWORD=troque-esta-senha-forte

# ─── Segredo do JWT — gere com: openssl rand -hex 32 ────────────────────
JWT_SECRET=cole-aqui-64-hex-de-openssl-rand-hex-32

# ─── CORS: URL do dashboard Angular (Cloudflare Pages) ──────────────────
CORS_ORIGINS=https://app.level30.online

# ─── Admin do seed (primeiro boot) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@level30.online
SEED_ADMIN_PASSWORD=troque-esta-senha-admin
SEED_ENABLED=true

# ─── Cloudflare Tunnel — token gerado no painel (Zero Trust > Networks > Tunnels) ─
TUNNEL_TOKEN=cole-o-token-do-tunnel-aqui

# ─── IA generativa — Worker já deployado (level30-ai-gateway) ───────────
# AI_SERVICE_TOKEN: NÃO está aqui de propósito (segredo). Pegue o valor com quem
# fez o deploy do Worker ou rode: cd server && npx wrangler secret list  (não mostra o valor)
# — na dúvida, gere um novo:  cd server && echo <novo> | npx wrangler secret put SERVICE_TOKEN
AI_WORKER_URL=https://level30-ai-gateway.mateusborbasouza.workers.dev
AI_SERVICE_TOKEN=
