# Copie para .env e preencha. NUNCA versione o .env.
#   cp .env.example .env

# ─── Banco (Postgres roda como container, conexão interna) ───────────────
DB_NAME=level30
DB_USER=level30
DB_PASSWORD=troque-esta-senha-forte

# ─── Segredo do JWT — gere com: openssl rand -hex 32 ────────────────────
JWT_SECRET=cole-aqui-64-hex-de-openssl-rand-hex-32

# ─── CORS: URL(s) do dashboard Angular, separadas por vírgula ───────────
# ex.: https://level30-dashboard.pages.dev  (ou seu domínio custom)
CORS_ORIGINS=https://SEU-DASHBOARD.pages.dev

# ─── Admin do seed (primeiro boot) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@seudominio.com
SEED_ADMIN_PASSWORD=troque-esta-senha-admin
SEED_ENABLED=true

# ─── Cloudflare Tunnel — token gerado no painel (Zero Trust > Networks > Tunnels) ─
TUNNEL_TOKEN=cole-o-token-do-tunnel-aqui

# ─── IA generativa (opcional) — deixe vazio p/ modo fallback determinístico ─
# Após `wrangler deploy` do server/ (ver server/README.md):
#   AI_WORKER_URL=https://level30-ai-gateway.SEU-SUBDOMINIO.workers.dev
#   AI_SERVICE_TOKEN = o mesmo valor do `wrangler secret put SERVICE_TOKEN`
AI_WORKER_URL=
AI_SERVICE_TOKEN=
