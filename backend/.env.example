# Level30 API — variáveis locais (Fase 6: camada Oracle PL/SQL).
# Copie para `.env` (gitignored) e ajuste. Nunca comite valores reais.
#
# Sem estas variáveis (ou com LEVEL30_ORACLE_ENABLED=false, o padrão), o backend
# sobe normalmente sem Oracle — é o que roda hoje em produção.

# Liga a camada Oracle (gateway de engajamento). false = comportamento atual, sem Oracle.
LEVEL30_ORACLE_ENABLED=false

# Liga o job diário (@Scheduled) que chama pr_verificar_inatividade.
# Deixe false se o job já está agendado no próprio Oracle via DBMS_SCHEDULER
# (ver db/oracle/05_job_opcional.sql) — senão a rotina roda duas vezes.
LEVEL30_ORACLE_INATIVIDADE_JOB=false

# --- Conexão com o Oracle local (docker-compose.oracle.yml) ---
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USER=level30
ORACLE_PASSWORD=troque-me

# --- Senha do usuário SYS/SYSTEM do container (só para o docker compose, não usada pelo backend) ---
ORACLE_SYS_PASSWORD=troque-me-tambem
